# ============================================================
# AIRank - Open-Source AI Brand Visibility Platform
# ============================================================
# Copy this file to .env and fill in your values.
# All variables here are documented; see README.md for details.
# ============================================================

# -------------------
# Core Application
# -------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
SESSION_SECRET=replace-with-32-plus-character-random-string

# -------------------
# Database (PostgreSQL)
# -------------------
# Neon Serverless: https://neon.tech
DATABASE_URL=postgresql://user:password@localhost:5432/airank
ALLOW_LOCAL_DATABASE_URL=true

# -------------------
# Redis (Job Queue & Cache)
# -------------------
# Local: redis://localhost:6379
# Upstash: redis://default:password@your-instance.upstash.io:6379
REDIS_URL=redis://localhost:6379

# -------------------
# Authentication
# -------------------
# Google OAuth (for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret (min 32 characters)
JWT_SECRET=replace-with-jwt-secret-min-32-chars

# -------------------
# LLM Providers (At least one required)
# -------------------

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

#  (fallback for multiple providers)
OPENROUTER_API_KEY=sk-or-v1-...

# Grok (xAI)
GROK_API_KEY=...

# Perplexity
PERPLEXITY_API_KEY=...

# -------------------
# Search & Enrichment
# -------------------

# Google Knowledge Graph API
GOOGLE_KG_API_KEY=AIza...

# SerpAPI (Google Search Results)
SERPAPI_API_KEY=...

# Firecrawl (Web Scraping)
FIRECRAWL_API_KEY=...

# -------------------
# Social Media Tracking
# -------------------
TWITTER_BEARER_TOKEN=...
LINKEDIN_ACCESS_TOKEN=...
YOUTUBE_API_KEY=...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...

# -------------------
# Email (AWS SES / SMTP)
# -------------------
EMAIL_PROVIDER=smtp  # or "ses"

# SMTP Configuration
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...

# SES Configuration
SES_REGION=ap-south-1
SES_ACCESS_KEY=...
SES_SECRET_KEY=...

# Sender Email
SES_FROM_EMAIL=noreply@airank.io
SES_FROM_NAME=AIRank

# -------------------
# Payments (Razorpay)
# -------------------
RAZORPAY_KEY_ID=...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# -------------------
# CORS & Security
# -------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
ALLOWED_IPS=127.0.0.1,::1

# -------------------
# Monitoring & Logging
# -------------------
LOG_LEVEL=info  # debug, info, warn, error
LOG_DIR=./logs

# Sentry (Error Tracking)
SENTRY_DSN=...

# -------------------
# Rate Limiting
# -------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# -------------------
# Feature Flags
# -------------------
ENABLE_SOCIAL_TRACKING=true
ENABLE_ENTITY_INTELLIGENCE=true
ENABLE_AGENT_READINESS=true
ENABLE_PRODUCT_READINESS=true
ENABLE_WEBHOOKS=true
ENABLE_2FA=true

# -------------------
# AI Credits (If using Anthropic/OpenAI credits)
# -------------------
# These are automatically detected from API keys above
# No additional configuration needed

# ============================================================
# Development Only (DO NOT USE IN PRODUCTION)
# ============================================================
# DEV_MODE=true
# SKIP_AUTH=false
# SEED_DEMO_DATA=false
