# ============================================================
# GeoScore .gitignore
# ============================================================

# ----- Dependencies -----
node_modules/
.pnpm-store/
dist/
build/
out/

# ----- Environment & Secrets (NEVER COMMIT) -----
.env
.env.*
.env.local
.env.production
.env.development
.env.backup-*
!.env.example

# ----- Database -----
*.sql
!migrations/**/*.sql
!shared/schema.ts

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug-log.txt
server-log.txt
log.md
ts-errors.txt

# ----- Backups & Data -----
backups/
*.backup-*
*.bak
*.tmp
*.orig
*.rej

# ----- OS / IDE -----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.fleet/
.cursor/

# ----- Replit-specific -----
.replit
.replit.nix
.upm/

# ----- Dev test/utility scripts -----
test.js
test-server.js
test-logger.mjs
test-startup.mjs
dbtest.cjs
gen-hash.cjs
gen-hash.js
get-otp.js
vite.config - Copy.ts
vite.config.ts.bak
vitest.config.ts.bak

# ----- Images & media (except generated logos) -----
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
!attached_assets/generated_images/**/*
!client/public/favicon.png
!client/public/logo.png
!client/public/opengraph.jpg
!client/public/og-image*
*.pdf

# ----- Internal dev notes (never for public) -----
markdowns/
docs/superpowers/
docs/implementation/
docs/analysis/
docs/migrations/
docs/GEOSCORE_GOAL_CONTINUATION_HANDOFF.md
docs/feature-parity-design.md

# ----- Misc internal files -----
ai-command-center-text.txt
dashboard-snapshot.yml
replit.md
audit.md
progress.md

# ----- Environment variable validation skip -----
# (keep .env.example tracked explicitly above)